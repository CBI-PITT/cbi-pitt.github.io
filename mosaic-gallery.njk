---
title: Mosaic Gallery
layout: base
permalink: /mosaic-gallery.html
---
<section class="page-hero">
  <div class="eyebrow">Explore</div>
  <h1 class="page-title">Mosaic <em>gallery</em></h1>
  <p class="page-sub">Mosaics assembled from thousands of individual micrographs — click any image to view it full size.</p>
</section>

<div class="masonry" style="columns: 2 320px;">
  {% for item in mosaics %}
  {% if item.image %}
  <figure class="masonry-item" data-lightbox data-caption="{{ item.title }}">
    <img src="{{ item.image | asset | url }}" alt="{{ item.title }}" loading="lazy">
  </figure>
  {% endif %}
  {% endfor %}
</div>
