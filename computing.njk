---
title: Computing
layout: base
permalink: /computing.html
---
<section class="page-hero">
  <div class="eyebrow">{{ computing.eyebrow }}</div>
  <h1 class="page-title">Computing</h1>
  <p class="page-sub">{{ computing.intro }}</p>
</section>

<h2 class="section-title">{{ computing.services_title | safe }}</h2>
<div class="sample-grid">
  {% for service in computing.services %}
  {% if service.github %}
  <div class="sample-card reveal">
    <span class="icon">{{ service.icon }}</span>
    <h3>{{ service.name }}</h3>
    <p>{{ service.description }}</p>
    <div class="sample-links">
      <a class="btn btn-primary" href="{{ service.url }}" target="_blank" rel="noopener">Open ↗</a>
      <a class="btn btn-ghost" href="{{ service.github }}" target="_blank" rel="noopener" aria-label="{{ service.name }} on GitHub">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" style="display:block"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
    </div>
  </div>
  {% else %}
  <a class="sample-card reveal" href="{{ service.url }}" target="_blank" rel="noopener">
    <span class="icon">{{ service.icon }}</span>
    <h3>{{ service.name }}</h3>
    <p>{{ service.description }}</p>
    <span class="btn btn-primary">Open ↗</span>
  </a>
  {% endif %}
  {% endfor %}
</div>
