---
title: Partners
description: "Research partners collaborating with the Center for Biologic Imaging."
layout: base
permalink: /partners.html
---
<section class="page-hero">
  <div class="eyebrow">{{ partners.eyebrow }}</div>
  <h1 class="page-title">Research Partners</h1>
  <p class="page-sub">{{ partners.intro }}</p>
</section>

<div class="partner-grid">
  {% for partner in partners.partners %}
  <a class="partner-card link-card reveal" href="{{ partner.url }}" target="_blank" rel="noopener">
    {% if partner.image %}<div class="link-card-media"{% if partner.mediaBg %} style="background: {{ partner.mediaBg }}"{% endif %}><img src="{{ partner.image | asset | url }}" alt="{{ partner.name }}" loading="lazy"{% if partner.fit or partner.maxWidth %} style="{% if partner.fit %}object-fit: {{ partner.fit }};{% endif %}{% if partner.maxWidth %} max-width: {{ partner.maxWidth }}; margin: 0 auto;{% endif %}"{% endif %}></div>{% endif %}
    <h3>{{ partner.name }}</h3>
    <p>{{ partner.description }}</p>
    <span class="more">Visit ↗</span>
  </a>
  {% endfor %}
</div>
