---
title: Faculty Publications
layout: base
permalink: /training.html
---
<section class="page-hero">
  <div class="eyebrow">Contact &amp; Resources</div>
  <h1 class="page-title">Faculty bio <em>&amp;</em> publications</h1>
</section>

{% for person in staff.faculty %}
<article class="faculty-card reveal">
  <div class="photo">
    {% if person.photo %}<img src="{{ person.photo | asset | url }}" alt="{{ person.name }}" loading="lazy">{% endif %}
  </div>
  <div>
    <h3>{{ person.name }}</h3>
    <p class="bio">{{ person.bio }}</p>
    <div class="faculty-links">
      {% if person.email %}<a class="chip" href="mailto:{{ person.email }}">✉ {{ person.email }}</a>{% endif %}
      {% if person.nih %}<a class="chip" href="{{ person.nih }}" target="_blank" rel="noopener">NIH Bibliography ↗</a>{% endif %}
      {% if person.scholar %}<a class="chip" href="{{ person.scholar }}" target="_blank" rel="noopener">Google Scholar ↗</a>{% endif %}
      {% if person.dept %}<a class="chip" href="{{ person.dept }}" target="_blank" rel="noopener">Dept profile ↗</a>{% endif %}
    </div>
  </div>
</article>
{% endfor %}
